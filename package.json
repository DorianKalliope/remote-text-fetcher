{
  "name": "remote-text-fetcher",
  "displayName": "Remote Text Fetcher",
  "description": "Fetches and displays text content from a configured URL in the output channel.",
  "version": "0.0.1",
  "publisher": "DorianN612",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Remote Text Fetcher",
      "properties": {
        "remoteTextFetcher.url": {
          "type": "string",
          "default": "http://localhost:3000/file.txt",
          "description": "URL to fetch test from"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}